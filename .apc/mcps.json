{
  "mcpServers": {
    "kaia_chrome_ropa": {
      "command": "bash",
      "args": [
        "-c",
        "cd /home/nico/.cache/kaia-mcp-work-Ropa && exec node /home/nico/.local/lib/kaia-browser-mcp/node_modules/@playwright/mcp/cli.js --browser chrome --output-dir /home/nico/.cache/kaia-mcp-output-Ropa"
      ],
      "env": {
        "DISPLAY": ":0",
        "WAYLAND_DISPLAY": "wayland-1",
        "XDG_RUNTIME_DIR": "/run/user/1000",
        "XDG_SESSION_TYPE": "wayland"
      }
    }
  }
}
